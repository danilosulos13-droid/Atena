# Copie para /etc/atena/atena.env e proteja com chmod 600.
ATENA_ROOT=/opt/atena
ATENA_LOCAL_MODEL=qwen2.5:3b-instruct
ATENA_OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
# Recomendado quando a API não estiver limitada a localhost.
# ATENA_API_TOKEN=gere-um-token-longo-e-aleatorio
# Nunca coloque valores reais no Git.
ATENA_TELEGRAM_BOT_TOKEN=use-secret-manager
ATENA_TELEGRAM_CHAT_ID=use-secret-manager
# Opcional: configure pelo menos um provedor para pesquisa web.
# ATENA_TAVILY_API_KEY=...
# ATENA_GOOGLE_API_KEY=...
# ATENA_GOOGLE_CSE_ID=...
# ATENA_BRAVE_SEARCH_API_KEY=...
