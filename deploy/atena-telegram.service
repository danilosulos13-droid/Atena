[Unit]
Description=Atena Telegram listener
Documentation=https://github.com/danilosulos13-droid/Atena
Wants=network-online.target
After=network-online.target atena-runtime.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/atena
EnvironmentFile=-/etc/atena/atena.env
Environment=PYTHONPATH=/opt/atena
Environment=ATENA_TELEGRAM_LOG_LEVEL=INFO
ExecStart=/opt/atena/.venv/bin/python scripts/atena_telegram_chat.py --poll-timeout 25
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/atena/atena_evolution /var/lib/atena
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
